FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 libglib2.0-0 libsm6 libxext6 libxrender1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY . .
COPY dev-entrypoint.sh /usr/local/bin/qsarify-dev-entrypoint
RUN chmod +x /usr/local/bin/qsarify-dev-entrypoint

ENV FLASK_ENV=development \
    QSARIFY_BACKEND_HOST=0.0.0.0 \
    QSARIFY_BACKEND_PORT=5051 \
    QSARIFY_RUNTIME_DIR=/var/lib/qsarify \
    QSARIFY_SESSION_DIR=/var/lib/qsarify/flask_session \
    QSARIFY_UPLOAD_FOLDER=/var/lib/qsarify/uploads \
    QSARIFY_MODEL_ARTIFACT_ROOT=/var/lib/qsarify/models

EXPOSE 5051
ENTRYPOINT ["/usr/local/bin/qsarify-dev-entrypoint"]
CMD ["python", "run.py"]
