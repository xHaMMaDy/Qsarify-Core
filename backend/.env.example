# Copy to an untracked local environment file. All secrets intentionally blank.
# Generate FLASK_SECRET_KEY locally for development; do not use this template value in production.
FLASK_SECRET_KEY=
FLASK_ENV=development
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=http://localhost:5001
PRODUCTION_URL=
QSARIFY_BACKEND_HOST=127.0.0.1
QSARIFY_BACKEND_PORT=5051
QSARIFY_RUNTIME_DIR=runtime
QSARIFY_SESSION_DIR=runtime/sessions
QSARIFY_MODEL_FOLDER=models
QSARIFY_UPLOAD_FOLDER=uploads
QSARIFY_LOG_DIR=logs
QSARIFY_MAX_TASKS=100
QSARIFY_TASK_TTL_SECONDS=3600
QSARIFY_MAX_PROCESSED_DATA=20
QSARIFY_PROCESSED_DATA_TTL_SECONDS=3600
QSARIFY_MAX_TRAINING_UPLOAD_FILES=10
QSARIFY_MAX_TRAINING_UPLOAD_ROWS=100000
QSARIFY_MAX_TRAINING_UPLOAD_COLUMNS=500
TARGET_INTELLIGENCE_LLM_ENABLED=false
OPENROUTER_EXTRACTION_MODEL=
OPENROUTER_REASONING_MODEL=
OPENROUTER_VERIFIER_MODEL=
TARGET_INTELLIGENCE_VERIFIER_ENABLED=false
TARGET_INTELLIGENCE_MAX_RESPONSE_TOKENS=1200
OPENAI_TARGET_INTELLIGENCE_MODEL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
ANTHROPIC_TARGET_INTELLIGENCE_MODEL=
ANTHROPIC_API_VERSION=
QSARIFY_TARGET_INTELLIGENCE_PUBLIC_LIMIT=0
QSARIFY_TARGET_INTELLIGENCE_CHAT_LIMIT=0
